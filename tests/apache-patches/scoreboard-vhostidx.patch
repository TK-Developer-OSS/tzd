diff -ru a/main/http_main.c b/main/http_main.c
--- a/main/http_main.c	2026-11-06 01:26:41.580085315 +0900
+++ b/main/http_main.c	2026-11-06 01:26:41.612634370 +0900
@@ -283,6 +283,30 @@
 /* *Non*-shared http_main globals... */
 
 static server_rec *server_conf;
+
+/* TzD (task #33): the scoreboard names a vhost by its position in the
+ * server_rec list instead of a pointer.  */
+API_EXPORT(int) ap_tzd_vhost_index(server_rec *s)
+{
+    server_rec *v;
+    int i = 0;
+    for (v = server_conf; v != NULL; v = v->next, i++)
+	if (v == s)
+	    return i;
+    return -1;
+}
+
+API_EXPORT(server_rec *) ap_tzd_vhost_at(int idx)
+{
+    server_rec *v;
+    int i = 0;
+    if (idx < 0)
+	return NULL;
+    for (v = server_conf; v != NULL; v = v->next, i++)
+	if (i == idx)
+	    return v;
+    return NULL;
+}
 #ifndef NETWARE
 static JMP_BUF APACHE_TLS jmpbuffer;
 #endif
