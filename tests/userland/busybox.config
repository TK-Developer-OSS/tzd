# busybox applets for the TzD minimal Linux (task #52), on top of
# allnoconfig (tests/userland/build_busybox.sh).  sh and init are TzD's own
# (tests/userland/{sh,init}.c).
CONFIG_STATIC=y
CONFIG_LFS=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=y
CONFIG_LONG_OPTS=y
CONFIG_BUSYBOX=y
CONFIG_FEATURE_INSTALLER=y
# coreutils
CONFIG_CAT=y
CONFIG_CHMOD=y
CONFIG_CP=y
CONFIG_DATE=y
CONFIG_DD=y
CONFIG_DF=y
CONFIG_DU=y
CONFIG_ECHO=y
CONFIG_ENV=y
CONFIG_FALSE=y
CONFIG_HEAD=y
CONFIG_ID=y
CONFIG_LN=y
CONFIG_LS=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_FOLLOWLINKS=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_FEATURE_LS_USERNAME=y
CONFIG_FEATURE_HUMAN_READABLE=y
CONFIG_MKDIR=y
CONFIG_MV=y
CONFIG_PWD=y
CONFIG_RM=y
CONFIG_RMDIR=y
CONFIG_SLEEP=y
CONFIG_SORT=y
CONFIG_STAT=y
CONFIG_SYNC=y
CONFIG_TAIL=y
CONFIG_TOUCH=y
CONFIG_TRUE=y
CONFIG_UNAME=y
CONFIG_UNIQ=y
CONFIG_WC=y
CONFIG_YES=y
# text
CONFIG_GREP=y
CONFIG_SED=y
CONFIG_MORE=y
# processes and system
CONFIG_PS=y
CONFIG_KILL=y
CONFIG_FREE=y
CONFIG_UPTIME=y
CONFIG_DMESG=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_HALT=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y
# network
CONFIG_IP=y
CONFIG_FEATURE_IP_ADDRESS=y
CONFIG_FEATURE_IP_LINK=y
CONFIG_FEATURE_IP_ROUTE=y
CONFIG_IFCONFIG=y
CONFIG_ROUTE=y
CONFIG_PING=y
CONFIG_WGET=y
CONFIG_NC=y
# Remote login (TK 2026-11-14): telnetd -> login -> the TzD sh.  busybox's
# own passwd/shadow parsing and crypt (SHA-512), so the password check is
# TzD code too, not glibc's NSS.
CONFIG_TELNETD=y
CONFIG_FEATURE_TELNETD_STANDALONE=y
CONFIG_FEATURE_TELNETD_PORT_DEFAULT=23
CONFIG_LOGIN=y
CONFIG_PASSWD=y
CONFIG_FEATURE_SHADOWPASSWDS=y
CONFIG_USE_BB_PWD_GRP=y
CONFIG_USE_BB_SHADOW=y
CONFIG_USE_BB_CRYPT=y
CONFIG_USE_BB_CRYPT_SHA=y
CONFIG_FEATURE_DEFAULT_PASSWD_ALGO="sha512"
# File transfer into the running guest: ftpd (login with the passwd
# accounts, uploads allowed) under tcpsvd; xmodem receive (rx; the host
# sends with lrzsz's sx over the serial line or telnet).
CONFIG_FTPD=y
CONFIG_FEATURE_FTPD_WRITE=y
CONFIG_FEATURE_FTPD_ACCEPT_BROKEN_LIST=y
CONFIG_FEATURE_FTPD_AUTHENTICATION=y
CONFIG_TCPSVD=y
CONFIG_RX=y
# Small tools: tty, password hashes (cryptpw), checksums of files put into
# the running guest.
CONFIG_TTY=y
CONFIG_CRYPTPW=y
CONFIG_MD5SUM=y
CONFIG_SHA256SUM=y
# The shell is TzD's own (tests/userland/sh.c).
CONFIG_SH_IS_NONE=y
# CONFIG_SH_IS_ASH is not set
# CONFIG_SHELL_ASH is not set
