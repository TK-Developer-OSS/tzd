# Minimal guest kernel (task #42): tinyconfig + serial console, initramfs,
# ELF, devtmpfs/proc/sys, virtio-net with IPv4, SysV IPC (Apache), no SMP
# (the bounds table is not SMP-safe yet), frame pointers.
CONFIG_64BIT=y
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_PCI=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y
CONFIG_VIRTIO_NET=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_SYSVIPC=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_FILE_LOCKING=y
CONFIG_UNIX98_PTYS=y
CONFIG_SMP=n
CONFIG_UNWINDER_FRAME_POINTER=y
# The bounds table's 512 MB pool is in .bss (kc2d, TK 2026-11-16): the image
# limit is 512 MB without KASLR, 1 GB with it.  Built KASLR-capable, booted
# with nokaslr (run_live.sh) and no memory randomization: the layout stays
# fixed (要確認: KASLR on, once kc2d's early boot is checked with it).
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=n
CONFIG_MAGIC_SYSRQ=y
# MPTCP on IPv4/IPv6 (TK 2026-11-18: make the Linux MPTCP use-after-free class testable)
CONFIG_MPTCP=y
CONFIG_MPTCP_IPV6=y
# Real SMP (TK 2026-11-19): CVE-2026-98432's race (kfree of inet_opt/ireq_opt
# without an RCU grace period) needs two CPUs actually running at once.
# kc2d's bounds table has no locking yet for concurrent access from real
# CPUs (task #49, not started): a trap under this config may be the race
# being caught, or kc2d itself misbehaving under concurrency -- do not
# assume either without checking.
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_HOTPLUG_CPU=y
# ACPI required: QEMU only announces CPU 1 via legacy MP-table (OEM: BOCHSCPU)
# when ACPI is off; CPU 1 never comes online. With ACPI, QEMU exposes both
# CPUs via MADT and the kernel brings up all -smp N CPUs.
CONFIG_ACPI=y
# AF_ALG AEAD (CVE-2026-31431: algif_aead in-place page-cache write)
# CRYPTO_USER_API must be explicit: Kconfig select chain is not reliably
# propagated by olddefconfig in a tinyconfig base.
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_AEAD=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_SEQIV=y
# The algorithms a CVE-2026-31431 PoC may use besides gcm(aes): authenc /
# authencesn (CRYPTO_AUTHENC builds both) over hmac(sha256) and cbc(aes),
# and the hash / skcipher AF_ALG interfaces (TK 2026-11-21).
CONFIG_CRYPTO_AUTHENC=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
# TC classifier + action for act_api UAF test (CVE class: kfree vs RCU reader)
# NET_SCHED / NET_CLS must be explicit: without them olddefconfig drops
# the four options below silently (tinyconfig base).
CONFIG_NET_SCHED=y
CONFIG_NET_CLS=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_EMATCH=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_ACT_GACT=y
CONFIG_NET_SCH_PRIO=y
# clsact (CONFIG_NET_SCH_INGRESS) for act_api UAF probe v3:
# clsact's egress hook runs in process context WITHOUT the qdisc spinlock,
# so Thread B is fully preemptible (CONFIG_PREEMPT=y) during tc_act.
# prio qdisc holds spin_lock(qdisc_lock) during the entire tc_act loop,
# disabling preemption and preventing the race from triggering reliably.
CONFIG_NET_SCH_INGRESS=y
# PREEMPT=y: allows the scheduler to preempt Thread B inside tc_act when
# Thread A is waiting for the CPU.  Both threads pinned to CPU 0 means
# the scheduler interleaves them; Thread A does kfree(a) while Thread B
# is preempted mid-tc_act, then Thread B resumes accessing freed a.
CONFIG_PREEMPT=y
