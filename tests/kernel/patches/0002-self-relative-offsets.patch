+++ b/arch/x86/kernel/alternative.c	2026-11-13 17:18:16.343047915 +0900
@@ -567,7 +567,7 @@
 
 static inline u8 * instr_va(struct alt_instr *i)
 {
-	return (u8 *)&i->instr_offset + i->instr_offset;
+	return (u8 *)((unsigned long)&i->instr_offset + i->instr_offset);
 }
 
